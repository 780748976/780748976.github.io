<!doctype html>
<html lang="zh-CN">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="theme-color" content="#f8b8c5">
  <title><%= page.title ? page.title + ' | ' : '' %><%= config.title %></title>
  <meta name="description" content="<%= page.description || config.description || config.subtitle %>">
  <link rel="icon" href="<%- url_for('/images/favicon.svg') %>" type="image/svg+xml">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Kiwi+Maru:wght@400;500&family=Noto+Sans+SC:wght@400;500;600;700&display=swap" rel="stylesheet">
  <%- css('css/style') %>
</head>
<body>
  <%- partial('_partial/header') %>
  <main>
    <%- body %>
  </main>
  <%- partial('_partial/footer') %>
  <%- js('js/theme') %>
</body>
</html>

